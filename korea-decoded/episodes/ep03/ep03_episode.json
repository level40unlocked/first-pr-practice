   "name_chips": true,
   "lines": [
    {
     "who": "anchor",
     "text": "So here's my take. Fifteen million visitors, a record chip boom, an alphabet with its own holiday. Different stories, same pattern: the world is showing up for Korea.",
     "audio": "audio/v1/ep03_95.mp3",
     "shot": "cam",
     "cam": [
      960,
      500,
      1.1
     ],
     "ease": 0.14,
     "cam_id": "two",
     "push": false
    },
    {
     "who": "anchor",
     "text": "And Korea's answer is very Korean: \"Welcome. Our home is your home. Please hurry.\"",
     "audio": "audio/v1/ep03_96.mp3",
     "shot": "cam",
     "cam": [
      960,
      500,
      1.1
     ],
     "ease": 0.14,
     "cam_id": "two",
     "push": false
    },
    {
     "who": "panel",
     "text": "Tell us in the comments: what's the first thing you'd ask a Korean?",
     "audio": "audio/v1/ep03_97.mp3",
     "shot": "cam",
     "cam": [
      960,
      500,
      1.1
     ],
     "ease": 0.14,
     "cam_id": "two",
     "push": false
    },
    {
     "who": "anchor",
     "text": "Subscribe, and we'll see you Wednesday. Stay curious. Keep your lenses clean.",
